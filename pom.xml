<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.jingji</groupId>
  <artifactId>springMVCTest01</artifactId>
  <packaging>war</packaging>
  <version>1.0-SNAPSHOT</version>
  <name>springMVCTest01 Maven Webapp</name>
  <url>http://maven.apache.org</url>
  <dependencies>

    <!-- Spring MVC 核心：DispatcherServlet、@Controller、HandlerMapping 等
         全在此包；传递引入 spring-core/spring-beans/spring-context 等全家桶。
         学习点：同一工程的 Spring 家族版本应保持一致（下面 spring-context
         显式声明 5.2.5 与这里 5.2.25 不一致，实际以就近声明为准，属可优化点） -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-webmvc</artifactId>
      <version>5.2.25.RELEASE</version>
    </dependency>

    <!-- Servlet API：scope=provided 表示"编译时要用、打包时不带"——
         Tomcat 自带这份 jar，war 里再带一份会冲突报 ClassCastException，
         这是 war 包项目的经典配置 -->
    <dependency>
      <groupId>javax.servlet</groupId>
      <artifactId>javax.servlet-api</artifactId>
      <version>3.1.0</version>
      <scope>provided</scope>
    </dependency>

    <!-- Spring IoC 核心：ApplicationContext 容器、依赖注入（@Service/@Autowired
         背后都是它）。虽然 spring-webmvc 会传递引入本包，显式声明可钉住版本；
         版本应与 webmvc 统一（见上方注释的不一致说明） -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-context</artifactId>
      <version>5.2.5.RELEASE</version>
    </dependency>
    <!-- 事务抽象层：@Transactional、事务传播行为等统一编程模型。
         mybatis-spring 底层管理数据库连接（SpringManagedTransaction）也要用它的类 -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-tx</artifactId>
      <version>5.2.5.RELEASE</version>
    </dependency>
    <!-- JDBC 支持层：把 MyBatis 异常翻译成 Spring 的 DataAccessException 体系，
         且将来启用声明式事务所需的 DataSourceTransactionManager 也在此包。
         本项目目前是单表 CRUD（自动提交即可），多表操作时再配置事务管理器 -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-jdbc</artifactId>
      <version>5.2.5.RELEASE</version>
    </dependency>
    <!-- MyBatis 核心：SqlSessionFactory/Executor、动态 SQL（<if>/<where>/<foreach>）。
         注意它本身不连数据库——真正建立连接靠下面的 mysql 驱动 -->
    <dependency>
      <groupId>org.mybatis</groupId>
      <artifactId>mybatis</artifactId>
      <version>3.5.1</version>
    </dependency>
    <!--mybatis和spring集成的依赖：SqlSessionFactoryBean、MapperScannerConfigurer 都在这里-->
    <dependency>
      <groupId>org.mybatis</groupId>
      <artifactId>mybatis-spring</artifactId>
      <version>1.3.1</version>
    </dependency>
    <!--mysql驱动：JDBC 协议实现，Java 代码与 MySQL 之间的"翻译官"-->
    <dependency>
      <groupId>mysql</groupId>
      <artifactId>mysql-connector-java</artifactId>
      <version>5.1.9</version>
    </dependency>
    <!-- PageHelper 分页插件：基于 MyBatis 拦截器机制，拦截 Executor 的 query，
         自动把业务 SQL 改写成 "count 总数 + limit 分页" 两句（插件配置见 mybatis.xml）。
         好处是 Service 层只需 PageHelper.startPage() 一行，SQL 一句不用改 -->
    <dependency>
      <groupId>com.github.pagehelper</groupId>
      <artifactId>pagehelper</artifactId>
      <version>5.3.0</version>
    </dependency>

    <!-- Druid 连接池（阿里出品）：预先建好连接循环"借出→归还"，
         省去每次请求 TCP 握手 + 权限认证的开销（配置见 springmvc.xml 数据源 Bean）。
         它还自带 SQL 监控页面，本项目未启用，只用了基础连接池能力 -->
    <dependency>
      <groupId>com.alibaba</groupId>
      <artifactId>druid</artifactId>
      <version>1.1.12</version>
    </dependency>
    <!-- JUnit：maven-archetype-webapp 自带的老版本，且项目还没有测试代码。
         学习点：真正写单测时建议升级 junit 4.13.2（或 JUnit 5），
         scope=test 表示只在 src/test 里可用，不会打进 war 包 -->
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>3.8.1</version>
      <scope>test</scope>
    </dependency>

    <!-- 日志门面 + 实现的经典组合（类似 JDBC 与驱动的分离）：
         slf4j-api 只定义接口，logback-classic 是实现并自动完成绑定。
         代码统一写 LoggerFactory.getLogger(...)，将来换 Log4j2 只换依赖不改代码。
         相比 System.out.println：有级别过滤、可格式化、可输出到文件（配置见 logback.xml） -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>1.7.30</version>
    </dependency>
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <version>1.2.3</version>
    </dependency>

    <!-- Apache POI：用于 Excel 文件导出 -->
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi</artifactId>
      <version>4.1.2</version>
    </dependency>

    <!-- Apache Commons FileUpload：用于头像上传 -->
    <dependency>
      <groupId>commons-fileupload</groupId>
      <artifactId>commons-fileupload</artifactId>
      <version>1.4</version>
    </dependency>
  </dependencies>
  <build>
    <finalName>springMVCTest01</finalName>
    <!-- 为什么需要这段：Maven 默认只把 src/main/resources 打进包，
         而 StudentDao.xml 放在 src/main/java（与接口同包，MyBatis 的惯例），
         不配置的话编译产物里找不到 Mapper XML，启动直接报
         "Invalid bound statement (not found)"——新手高频报错之一 -->
    <resources>
      <resource>
        <directory>src/main/java</directory><!--所在的目录-->
        <includes><!--包括目录下的.properties,.xml 文件都会扫描到-->
          <include>**/*.properties</include>
          <include>**/*.xml</include>
        </includes>
        <filtering>false</filtering>
      </resource>
    </resources>
    <!--指定jdk的版本-->
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.1</version>
        <configuration>
          <source>1.8</source>
          <target>1.8</target>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
