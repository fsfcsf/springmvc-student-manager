<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:context="http://www.springframework.org/schema/context"
       xmlns:mvc="http://www.springframework.org/schema/mvc"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans.xsd
       http://www.springframework.org/schema/context
       http://www.springframework.org/schema/context/spring-context.xsd
       http://www.springframework.org/schema/mvc
       http://www.springframework.org/schema/mvc/spring-mvc.xsd">
    <!-- 加载外部数据库配置文件：把 jdbc.properties 的键值对注册成 ${jdbc.xxx} 占位符。
         好处：数据库地址/账号/密码与配置文件解耦，换环境只改 properties 不动 XML，
         且真实密码文件已加入 .gitignore，不会提交到代码仓库 -->
    <context:property-placeholder location="classpath:jdbc.properties" />

    <!-- 数据源（连接池）。为什么需要"池"：建立一次 MySQL 连接要经历
         TCP 三次握手 + 权限认证，约几十毫秒；每次请求都新建/销毁太浪费。
         池子提前建好 N 个连接循环"借出→归还"，用空间换时间 -->
    <bean id="myDataSource" class="com.alibaba.druid.pool.DruidDataSource"
          init-method="init" destroy-method="close"> <!-- 生命周期回调：容器启动建池，关闭时释放全部连接 -->
        <property name="url" value="${jdbc.url}" /> <!-- ${} 从 jdbc.properties 取值，set 注入 -->
        <property name="username" value="${jdbc.username}" />
        <property name="password" value="${jdbc.password}" />
        <property name="maxActive" value="${jdbc.maxActive}" /> <!-- 最大并发连接数，超出的请求排队等待 -->
    </bean>

    <!--声明的是mybatis中提供的SqlSessionFactoryBean类，这个类内部创建SqlSessionFactory的
        SqlSessionFactory  sqlSessionFactory = new ..
    -->
    <bean id="sqlSessionFactory" class="org.mybatis.spring.SqlSessionFactoryBean">
        <!--set注入，把数据库连接池付给了dataSource属性-->
        <property name="dataSource" ref="myDataSource" />
        <!--mybatis主配置文件的位置
           configLocation属性是Resource类型，读取配置文件
           它的赋值，使用value，指定文件的路径，使用classpath:表示文件的位置
        -->
        <property name="configLocation" value="classpath:mybatis.xml"></property>
    </bean>

    <!--创建dao对象，使用SqlSession的getMapper（StudentDao.class）
        MapperScannerConfigurer:在内部调用getMapper()生成每个dao接口的代理对象。

    -->
    <bean class="org.mybatis.spring.mapper.MapperScannerConfigurer">
        <!-- 指定 SqlSessionFactory 的 Bean 名。注意属性名是 sqlSessionFactoryBeanName（字符串）
             而不是 sqlSessionFactory（对象引用）：后者会让本 Bean 抢先初始化，
             ${jdbc.xxx} 占位符还没解析完就去建连接池导致取不到值——经典坑 -->
        <property name="sqlSessionFactoryBeanName" value="sqlSessionFactory" />
        <!--指定包名， 包名是dao接口所在的包名。
            MapperScannerConfigurer会扫描这个包中的所有接口，把每个接口都执行
            一次getMapper()方法，得到每个接口的dao对象。
            创建好的dao对象放入到spring的容器中的。 dao对象的默认名称是 接口名首字母小写
        -->
        <property name="basePackage" value="com.jingji.dao"/>
    </bean>

    <!-- 注解扫描：把 @Service 标注的类注册成 Spring Bean。
         实际上 service 和 controller 两条可合并为 base-package="com.jingji" -->
    <context:component-scan base-package="com.jingji.service" />

    <!-- 扫描 Controller 组件包：@Controller 标注的类才能处理请求
         （没被扫描的类上的 @RequestMapping 不会生效） -->
    <context:component-scan base-package="com.jingji.controller"/>

    <!-- 注解驱动：向容器注册 RequestMappingHandlerMapping/HandlerAdapter 等
         一整套组件，@RequestMapping/@RequestParam/@ResponseBody 才能生效，
         同时隐含开启参数类型转换（如请求参数 String → int/boolean） -->
    <mvc:annotation-driven/>

    <!-- 登录拦截器配置：mapping=拦截范围，exclude-mapping=白名单放行。
         放行的四个路径都是"未登录也要能访问"的页面/接口。
         注意：直接访问 JSP（如 /index.jsp）不走 MVC 注解路由，由下面的
         default-servlet-handler 交给 Tomcat 默认 Servlet 处理，天然不受拦截 -->
    <mvc:interceptors>
        <mvc:interceptor>
            <!--拦截所有 /user/ 下的请求，排除登录和注册-->
            <mvc:mapping path="/user/**"/>
            <mvc:exclude-mapping path="/user/login"/>
            <mvc:exclude-mapping path="/user/register"/>
            <mvc:exclude-mapping path="/user/registerSuccess"/>
            <mvc:exclude-mapping path="/user/captcha"/>
            <bean class="com.jingji.controller.LoginInterceptor">
                <property name="studentService" ref="studentService"/>
            </bean>
        </mvc:interceptor>
    </mvc:interceptors>

    <!-- 文件上传解析器，用于头像上传。
         关键约定：id 必须一字不差叫 multipartResolver——DispatcherServlet 初始化时
         按这个固定名查找，起别的名字 Spring 装配不到，上传功能直接失效，
         这是"排错半天"的经典坑 -->
    <bean id="multipartResolver" class="org.springframework.web.multipart.commons.CommonsMultipartResolver">
        <property name="maxUploadSize" value="2097152"/> <!-- 最大 2MB（字节），超限抛 MaxUploadSizeExceededException -->
    </bean>

    <!-- 静态资源放行：DispatcherServlet 的 url-pattern 是 "/"，抢走了所有请求，
         加这一行把 css/js/图片等静态资源转回给 Tomcat 默认 Servlet 处理，
         否则静态资源 404（被当成 Controller 路径去找了） -->
    <mvc:default-servlet-handler/>


    <!-- 视图解析器：把 Controller 返回的"逻辑视图名"翻译成真实 JSP 路径。
         例：返回 "showAllStudent" → 拼成 "/showAllStudent.jsp"
         （前缀 / + 视图名 + 后缀 .jsp），实现"Controller 与页面物理路径解耦"；
         若返回值带 redirect: / forward: 前缀则不走本解析器 -->
    <bean id="viewResolver" class="org.springframework.web.servlet.view.InternalResourceViewResolver">
        <!--前缀：/ 指 webapp 根路径，从 webapp 根路径下查找视图文件-->
        <property name="prefix" value="/"/>
        <!--后缀：统一 .jsp 文件-->
        <property name="suffix" value=".jsp"/>
    </bean>

</beans>