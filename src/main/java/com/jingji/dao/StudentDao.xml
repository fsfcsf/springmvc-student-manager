<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
    StudentDao 的 SQL 映射文件
    每个标签的 id 对应 StudentDao 接口中的方法名
    namespace 指定对应的接口全限定名
-->
<mapper namespace="com.jingji.dao.StudentDao">

    <!-- 新增学生 -->
    <insert id="insertStudent">
        insert into student2 values (#{id},#{name},#{uname},#{upass},#{age},#{email})
    </insert>

    <!-- 根据 ID 查询单个学生 -->
    <select id="queryStudentById" resultType="Student">
        SELECT id,name,uname,upass,age,email from student2 WHERE id = #{stuId}
    </select>

    <!-- 查询所有学生，按 ID 升序排列 -->
    <select id="queryAll" resultType="Student">
        SELECT id,name,uname,upass,age,email from student2 order by id asc
    </select>

    <!-- 根据 ID 删除学生 -->
    <delete id="deleteStudentById">
        delete from student2 where id = #{stuId}
    </delete>

    <!-- 根据 ID 更新学生信息 -->
    <update id="updateStudentById" parameterType="Student">
        UPDATE student2
        SET name = #{name},
            uname = #{uname},
            upass = #{upass},
            age = #{age},
            email = #{email}
        WHERE id = #{id}
    </update>

    <!-- 根据姓名模糊查询，使用 like 进行模糊匹配 -->
    <select id="findByName" resultType="Student">
        SELECT id,name,uname,upass,age,email FROM student2 WHERE name like #{name};
    </select>

    <!-- 根据账号精确查询，用于登录校验 -->
    <select id="findByUname" resultType="Student">
        SELECT id,name,uname,upass,age,email FROM student2 WHERE uname = #{uname}
    </select>

</mapper>